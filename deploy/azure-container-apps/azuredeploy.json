{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.31.92.45157",
      "templateHash": "6040597011963382501"
    }
  },
  "parameters": {
    "hubAddress": {
      "type": "string",
      "metadata": {
        "description": "Hub address from Instalily, as IP:port, e.g. 203.0.113.10:443."
      }
    },
    "enrollmentToken": {
      "type": "securestring",
      "metadata": {
        "description": "Enrollment token from Instalily. It is valid for 24 hours by default; ask for a new one if it has expired."
      }
    },
    "allow": {
      "type": "array",
      "metadata": {
        "description": "Targets Instalily may reach, as JSON. Each entry is a \"cidr\" (a range or one IP) or a \"host\" (a name, or \"*.corp.example\" for any name under it), with \"ports\". Example: [{\"cidr\": \"10.1.2.3\", \"ports\": [1433]}]"
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing virtual network. It must route to the targets."
      }
    },
    "virtualNetworkResourceGroup": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource group of the virtual network. Leave empty if it is this deployment's resource group."
      }
    },
    "subnetName": {
      "type": "string",
      "metadata": {
        "description": "Name of the subnet for Container Apps. With Subnet Address Prefix empty: an existing subnet, at least /27, delegated to Microsoft.App/environments and used by nothing else. Otherwise, the name of the subnet this creates."
      }
    },
    "subnetAddressPrefix": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Leave empty to use the existing subnet above. Or give a free range in the virtual network, at least /27 (e.g. 10.20.3.0/27): this then creates the subnet, delegated to Microsoft.App/environments, with a network security group allowing what the connector and Container Apps need. Needs permission to change the virtual network, and Hub Address as IP:port."
      }
    },
    "denyOtherOutbound": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Only with Subnet Address Prefix: also deny all other outbound traffic from the subnet, so it can reach only what the rules allow."
      }
    },
    "name": {
      "type": "string",
      "defaultValue": "edge-connector",
      "maxLength": 32,
      "metadata": {
        "description": "Prefix for the names of everything this creates."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region. Defaults to the resource group's, which must be the virtual network's."
      }
    },
    "connectorImage": {
      "type": "string",
      "defaultValue": "public.ecr.aws/s9u8g9q7/edge-connector@sha256:2473f9b660218932ec4f93b5651d7a64fb922748ec4df42a5e75a564717d2cee",
      "metadata": {
        "description": "Connector image, pinned by digest. Instalily sends a new one for each upgrade."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "targetRules",
        "count": "[length(parameters('allow'))]",
        "input": {
          "name": "[format('allow-target-{0}', copyIndex('targetRules'))]",
          "properties": {
            "description": "An allowlisted target.",
            "priority": "[add(200, copyIndex('targetRules'))]",
            "direction": "Outbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
            "sourcePortRange": "*",
            "destinationAddressPrefix": "[coalesce(tryGet(parameters('allow')[copyIndex('targetRules')], 'cidr'), 'VirtualNetwork')]",
            "destinationPortRanges": "[map(parameters('allow')[copyIndex('targetRules')].ports, lambda('port', string(lambdaVariables('port'))))]"
          }
        }
      }
    ],
    "createSubnet": "[not(empty(parameters('subnetAddressPrefix')))]",
    "vnetResourceGroup": "[if(empty(parameters('virtualNetworkResourceGroup')), resourceGroup().name, parameters('virtualNetworkResourceGroup'))]",
    "hubIp": "[split(parameters('hubAddress'), ':')[0]]",
    "hubPort": "[last(split(parameters('hubAddress'), ':'))]",
    "fixedRules": [
      {
        "name": "allow-hub",
        "properties": {
          "description": "The tunnel to Instalily's hub.",
          "priority": 100,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "[variables('hubIp')]",
          "destinationPortRange": "[variables('hubPort')]"
        }
      },
      {
        "name": "allow-image",
        "properties": {
          "description": "The connector image: public.ecr.aws and its CloudFront layer host, which have no fixed IPs.",
          "priority": 300,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "Internet",
          "destinationPortRange": "443"
        }
      },
      {
        "name": "allow-storage-smb",
        "properties": {
          "description": "The Azure Files share that holds the connector's key.",
          "priority": 310,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "Storage",
          "destinationPortRange": "445"
        }
      },
      {
        "name": "allow-container-registry",
        "properties": {
          "description": "Container Apps system containers.",
          "priority": 320,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "MicrosoftContainerRegistry",
          "destinationPortRange": "443"
        }
      },
      {
        "name": "allow-front-door-first-party",
        "properties": {
          "description": "A dependency of MicrosoftContainerRegistry.",
          "priority": 330,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "AzureFrontDoor.FirstParty",
          "destinationPortRange": "443"
        }
      },
      {
        "name": "allow-azure-monitor",
        "properties": {
          "description": "The connector's logs, to Log Analytics.",
          "priority": 340,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "AzureMonitor",
          "destinationPortRange": "443"
        }
      },
      {
        "name": "allow-azure-dns",
        "properties": {
          "description": "Azure DNS. Microsoft warns that denying it breaks the environment.",
          "priority": 350,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "*",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "168.63.129.16",
          "destinationPortRange": "53"
        }
      },
      {
        "name": "allow-within-subnet",
        "properties": {
          "description": "Traffic within the Container Apps environment.",
          "priority": 360,
          "direction": "Outbound",
          "access": "Allow",
          "protocol": "*",
          "sourceAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "destinationPortRange": "*"
        }
      },
      {
        "name": "allow-load-balancer-probes",
        "properties": {
          "description": "Azure's health probes to the environment.",
          "priority": 100,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "AzureLoadBalancer",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "[parameters('subnetAddressPrefix')]",
          "destinationPortRange": "30000-32767"
        }
      }
    ],
    "denyRule": [
      {
        "name": "deny-other-outbound",
        "properties": {
          "description": "Everything the rules above do not allow.",
          "priority": 4096,
          "direction": "Outbound",
          "access": "Deny",
          "protocol": "*",
          "sourceAddressPrefix": "*",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "*"
        }
      }
    ],
    "config": {
      "hub": {
        "address": "[parameters('hubAddress')]",
        "connections": 2
      },
      "state_dir": "/var/lib/edge-connector",
      "enrollment": {
        "token_file": "/etc/edge-connector/token"
      },
      "allow": "[parameters('allow')]",
      "health_listen": "127.0.0.1:8080"
    }
  },
  "resources": [
    {
      "condition": "[variables('createSubnet')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}-nsg', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[concat(variables('fixedRules'), variables('targetRules'), if(parameters('denyOtherOutbound'), variables('denyRule'), createArray()))]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[format('edgec{0}', uniqueString(resourceGroup().id, parameters('name')))]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))), 'default', 'state')]",
      "properties": {
        "shareQuota": 1
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2023-09-01').primarySharedKey]"
          }
        },
        "vnetConfiguration": {
          "infrastructureSubnetId": "[if(variables('createSubnet'), reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('vnetResourceGroup')), 'Microsoft.Resources/deployments', format('{0}-subnet', parameters('name'))), '2022-09-01').outputs.id.value, resourceId(variables('vnetResourceGroup'), 'Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('subnetName')))]",
          "internal": true
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name')))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('vnetResourceGroup')), 'Microsoft.Resources/deployments', format('{0}-subnet', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('name')), 'state')]",
      "properties": {
        "azureFile": {
          "accountName": "[format('edgec{0}', uniqueString(resourceGroup().id, parameters('name')))]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name')))), '2023-05-01').keys[0].value]",
          "shareName": "state",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))), 'default', 'state')]",
        "[resourceId('Microsoft.Storage/storageAccounts', format('edgec{0}', uniqueString(resourceGroup().id, parameters('name'))))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": [
            {
              "name": "config",
              "value": "[string(variables('config'))]"
            },
            {
              "name": "token",
              "value": "[parameters('enrollmentToken')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "connector",
              "image": "[parameters('connectorImage')]",
              "args": [
                "-config",
                "/etc/edge-connector/config.yaml"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "volumeMounts": [
                {
                  "volumeName": "config",
                  "mountPath": "/etc/edge-connector"
                },
                {
                  "volumeName": "state",
                  "mountPath": "/var/lib/edge-connector"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "volumes": [
            {
              "name": "config",
              "storageType": "Secret",
              "secrets": [
                {
                  "secretRef": "config",
                  "path": "config.yaml"
                },
                {
                  "secretRef": "token",
                  "path": "token"
                }
              ]
            },
            {
              "name": "state",
              "storageType": "AzureFile",
              "storageName": "state",
              "mountOptions": "uid=65532,gid=65532,dir_mode=0700,file_mode=0600"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('name')), 'state')]"
      ]
    },
    {
      "condition": "[variables('createSubnet')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-subnet', parameters('name'))]",
      "resourceGroup": "[variables('vnetResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "virtualNetworkName": {
            "value": "[parameters('virtualNetworkName')]"
          },
          "subnetName": {
            "value": "[parameters('subnetName')]"
          },
          "addressPrefix": {
            "value": "[parameters('subnetAddressPrefix')]"
          },
          "networkSecurityGroupId": {
            "value": "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', parameters('name')))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.31.92.45157",
              "templateHash": "11167005774412104964"
            }
          },
          "parameters": {
            "virtualNetworkName": {
              "type": "string",
              "metadata": {
                "description": "Name of the existing virtual network."
              }
            },
            "subnetName": {
              "type": "string",
              "metadata": {
                "description": "Name of the subnet to create."
              }
            },
            "addressPrefix": {
              "type": "string",
              "metadata": {
                "description": "Its address range: free in the virtual network, at least /27."
              }
            },
            "networkSecurityGroupId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the network security group to attach."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/virtualNetworks/subnets",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}', parameters('virtualNetworkName'), parameters('subnetName'))]",
              "properties": {
                "addressPrefix": "[parameters('addressPrefix')]",
                "networkSecurityGroup": {
                  "id": "[parameters('networkSecurityGroupId')]"
                },
                "delegations": [
                  {
                    "name": "container-apps",
                    "properties": {
                      "serviceName": "Microsoft.App/environments"
                    }
                  }
                ]
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('subnetName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', parameters('name')))]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[parameters('name')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[format('edgec{0}', uniqueString(resourceGroup().id, parameters('name')))]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[format('{0}-logs', parameters('name'))]"
    }
  }
}